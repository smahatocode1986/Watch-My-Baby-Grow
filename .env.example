# Optional: copy this file to .env and put your key in .env only.
# Never commit or share the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Optional Supabase persistence. Use a server-side secret key, never a publishable key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=app_state
SUPABASE_STATE_ID=littlebloom
